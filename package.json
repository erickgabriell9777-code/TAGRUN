{
  "name": "tagrun",
  "version": "0.3.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "vite --host 0.0.0.0",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "deploy": "npm run build:web && wrangler deploy"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-location": "~19.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^6.3.5",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.68.0"
  }
}
